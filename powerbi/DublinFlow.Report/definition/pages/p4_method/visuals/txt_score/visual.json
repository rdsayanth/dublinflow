    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the score works",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reliability Score = 100 x (1 - share of service time the station is empty - share of time it is full)."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Empty = 0 bikes available. Full = 0 free docks. 100 means there was always a bike and a free dock."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Service hours are 05:00 to 23:59 Irish time. Each station-hour counts equally."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A station with 0 bikes and 0 docks is out of service: that time is left out of the score and reported separately as % Out of Service."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
