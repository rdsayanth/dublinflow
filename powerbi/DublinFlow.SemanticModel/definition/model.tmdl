model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IE
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fct_station_hourly","dim_station","dim_hour","mart_station_reliability"]

annotation PBI_ProTooling = ["DevMode"]

ref table fct_station_hourly
ref table dim_station
ref table dim_hour
ref table mart_station_reliability
ref table Date

ref cultureInfo en-US

