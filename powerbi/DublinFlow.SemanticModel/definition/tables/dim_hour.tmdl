/// One row per UTC hour with Irish local time parts and Met Éireann Dublin Airport weather.
table dim_hour
	lineageTag: 30e2c4bd-ab31-5df5-814c-74de7d677ab7

	column hour_utc
		dataType: dateTime
		formatString: General Date
		lineageTag: 43a6e3fa-6bd4-5618-963a-7d4a56d2ed8f
		summarizeBy: none
		sourceColumn: hour_utc

		annotation SummarizationSetBy = User

	column hour_local
		dataType: dateTime
		formatString: General Date
		lineageTag: d0d73f25-5e98-5664-96c0-88452c2cfda7
		summarizeBy: none
		sourceColumn: hour_local

		annotation SummarizationSetBy = User

	column date_local
		dataType: dateTime
		formatString: Short Date
		lineageTag: 8efc5991-84c8-57bf-9213-f524dc58ecf3
		summarizeBy: none
		sourceColumn: date_local

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column hour_of_day_local
		dataType: int64
		formatString: 0
		lineageTag: 887cebaa-8c22-507e-8fd0-18bcd396f719
		summarizeBy: none
		sourceColumn: hour_of_day_local

		annotation SummarizationSetBy = User

	column day_of_week
		dataType: int64
		formatString: 0
		lineageTag: 08c3fa6f-1165-5094-b62a-7d089c2bfdcb
		summarizeBy: none
		sourceColumn: day_of_week

		annotation SummarizationSetBy = User

	column day_name
		dataType: string
		lineageTag: bfcceb50-c613-55c0-a6e6-b55ccbee3c84
		summarizeBy: none
		sourceColumn: day_name
		sortByColumn: day_of_week

		annotation SummarizationSetBy = User

	column is_weekend
		dataType: boolean
		lineageTag: 2dbed222-7c6c-55c4-9d10-4d87d11f623c
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = User

	column is_service_hour
		dataType: boolean
		lineageTag: 5e0c3c4a-fa97-5b1e-878c-62beefcc7ee3
		summarizeBy: none
		sourceColumn: is_service_hour

		annotation SummarizationSetBy = User

	column rain_mm
		dataType: double
		formatString: 0.0
		lineageTag: abdfc8a6-0dcf-5b61-bb66-cd10818cce3f
		summarizeBy: none
		sourceColumn: rain_mm

		annotation SummarizationSetBy = User

	column temp_c
		dataType: double
		formatString: 0.0
		lineageTag: d2565f85-e4e7-579f-83dc-1f101fc0f6dd
		summarizeBy: none
		sourceColumn: temp_c

		annotation SummarizationSetBy = User

	column wind_speed_kt
		dataType: int64
		formatString: 0
		lineageTag: 784ccf2b-ca1d-50a8-8127-e80e1222a81e
		summarizeBy: none
		sourceColumn: wind_speed_kt

		annotation SummarizationSetBy = User

	column humidity_pct
		dataType: int64
		formatString: 0
		lineageTag: e5cc0180-7574-5f38-962a-afd87ca1732f
		summarizeBy: none
		sourceColumn: humidity_pct

		annotation SummarizationSetBy = User

	column sunshine_hours
		dataType: double
		formatString: 0.0
		lineageTag: 881980b3-8f57-5f00-a569-9fd735dd58de
		summarizeBy: none
		sourceColumn: sunshine_hours

		annotation SummarizationSetBy = User

	column is_rain_hour
		dataType: boolean
		lineageTag: 7a30bcd7-7929-5dd0-adb1-79f820c1b13b
		summarizeBy: none
		sourceColumn: is_rain_hour

		annotation SummarizationSetBy = User

	/// Weekday or Weekend (readable label for is_weekend).
	column 'Day Type' = IF(dim_hour[is_weekend], "Weekend", "Weekday")
		dataType: string
		lineageTag: e225c94f-a400-5c52-b316-05c052faaba2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_hour = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "dublinflow"),
				    analytics_dim_hour = Source{[Schema="analytics", Item="dim_hour"]}[Data]
				in
				    analytics_dim_hour

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

