# Copy this file to .env and fill in real values. Never commit .env.
# Blob SAS URL for the "raw" container (permissions: add, create, write only)
AZURE_RAW_CONTAINER_SAS_URL=
# Blob SAS URL for the loader (permissions: read, list only)
AZURE_RAW_CONTAINER_READ_SAS_URL=
# Local PostgreSQL connection (standard PostgreSQL variable names)
PGHOST=localhost
PGPORT=5432
PGDATABASE=dublinflow
PGUSER=postgres
PGPASSWORD=
# dbt: where the project and profiles.yml live (relative to the repo root)
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt